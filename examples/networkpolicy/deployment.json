{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "api",
    "namespace": "payments"
  },
  "spec": {
    "selector": {
      "matchLabels": {
        "app": "api"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "api",
          "tier": "backend"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "api",
            "image": "example.invalid/api:latest"
          }
        ]
      }
    }
  }
}
