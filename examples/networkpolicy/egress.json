{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "api-egress",
    "namespace": "payments"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "api"
      }
    },
    "policyTypes": ["Egress"],
    "egress": [
      {
        "to": [
          {
            "ipBlock": {
              "cidr": "10.0.0.0/8"
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 443
          }
        ]
      }
    ]
  }
}
